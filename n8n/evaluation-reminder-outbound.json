{
  "name": "Evaluation Reminder - Outbound (WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "content": "## Before this will work\n1. Create a **Supabase** credential (Host = your project URL, Service Role Secret = your service_role key) and attach it to both Supabase HTTP Request nodes.\n2. Create an **HTTP Header Auth** credential named e.g. \"Meta WhatsApp Access Token\" -- Name: `Authorization`, Value: `Bearer YOUR_LONG_LIVED_TOKEN`. Attach it to the \"Send WhatsApp Template\" node.\n3. Open the CONFIG node below and replace the two placeholder values with your real Supabase URL and WhatsApp Phone Number ID.\n4. Run once manually (the Manual Trigger) before turning on the schedule, to confirm it all works end to end.",
        "height": 400,
        "width": 380
      },
      "id": "sticky-setup",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-480, -80]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-480, 160]
    },
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger (Testing)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-480, 340]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-supabase-url",
              "name": "supabaseUrl",
              "value": "https://YOUR-PROJECT.supabase.co",
              "type": "string"
            },
            {
              "id": "cfg-phone-id",
              "name": "whatsappPhoneNumberId",
              "value": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
              "type": "string"
            },
            {
              "id": "cfg-graph-version",
              "name": "whatsappGraphVersion",
              "value": "v21.0",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config-node",
      "name": "CONFIG",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-240, 240]
    },
    {
      "parameters": {
        "jsCode": "// Window sized to comfortably straddle the 15-minute poll interval --\n// wide enough that no evaluation ever falls through the gap between two\n// consecutive runs, without so wide a window that reminder_sent alone\n// isn't enough to prevent a duplicate send.\nconst now = Date.now();\nconst windowStart = new Date(now + 110 * 60 * 1000).toISOString(); // now + 1h50m\nconst windowEnd   = new Date(now + 125 * 60 * 1000).toISOString(); // now + 2h05m\n\nreturn [{\n  json: {\n    ...items[0].json,\n    windowStart,\n    windowEnd,\n  },\n}];"
      },
      "id": "compute-window",
      "name": "Compute Reminder Window",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 240]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "url": "={{ $json.supabaseUrl }}/rest/v1/evaluations",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,scheduled_at,property_id,sellers_agent_user_id,properties(street_number,street_name,suburb,city),agent:profiles!sellers_agent_user_id(full_name,phone_number),evaluation_contacts(is_primary,tag_option_id,contacts(first_name,last_name,phone_number),picklist_options:tag_option_id(label))"
            },
            { "name": "reminder_sent", "value": "eq.false" },
            { "name": "scheduled_at", "value": "=gte.{{ $json.windowStart }}" },
            { "name": "scheduled_at", "value": "=lte.{{ $json.windowEnd }}" },
            { "name": "order", "value": "scheduled_at.asc" }
          ]
        },
        "options": {}
      },
      "id": "fetch-due",
      "name": "Fetch Due Evaluations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 240],
      "credentials": {
        "supabaseApi": { "id": "1", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "jsCode": "// One item per due evaluation, with every WhatsApp template variable\n// pre-filled -- or a skip_reason if something needed to send it is\n// missing (no seller, no seller phone, no agent phone). Nothing here\n// ever silently drops an evaluation: it either sends or is explicitly\n// logged as skipped by the IF node right after this.\nconst results = [];\n\nfor (const item of items) {\n  const ev = item.json;\n  const contacts = ev.evaluation_contacts || [];\n\n  // Same fallback order the app itself uses: Seller-tagged contact,\n  // else whichever contact is marked primary, else the first one.\n  const sellerLink = contacts.find(c => c.picklist_options && c.picklist_options.label === 'Seller')\n    || contacts.find(c => c.is_primary)\n    || contacts[0];\n  const seller = sellerLink ? sellerLink.contacts : null;\n\n  const agent = ev.agent;\n  const prop  = ev.properties;\n  const address = [prop && prop.street_number, prop && prop.street_name, prop && prop.suburb, prop && prop.city]\n    .filter(Boolean).join(', ');\n\n  const sellerName  = seller ? [seller.first_name, seller.last_name].filter(Boolean).join(' ').trim() : null;\n  const sellerPhone = seller ? seller.phone_number : null;\n  const agentName   = agent && agent.full_name ? agent.full_name : null;\n  const agentPhone  = agent ? agent.phone_number : null;\n\n  const time = new Date(ev.scheduled_at).toLocaleString('en-ZA', {\n    timeZone: 'Africa/Johannesburg',\n    weekday: 'short', day: 'numeric', month: 'short',\n    hour: '2-digit', minute: '2-digit', hour12: false,\n  });\n\n  let skipReason = null;\n  if (!seller) skipReason = 'No contact attached to this evaluation';\n  else if (!sellerName) skipReason = 'Seller contact has no name on file';\n  else if (!sellerPhone) skipReason = 'Seller contact has no phone number on file';\n  else if (!agentPhone) skipReason = 'Assigned agent has no phone number on file';\n  else if (!agentName) skipReason = 'Evaluation has no assigned agent';\n\n  results.push({\n    json: {\n      evaluation_id: ev.id,\n      seller_name: sellerName,\n      agent_name: agentName,\n      evaluation_time: time,\n      property_address: address || 'the property',\n      agent_phone_display: agentPhone,\n      seller_phone_e164: sellerPhone,\n      seller_phone_dial: sellerPhone ? sellerPhone.replace('+', '') : null,\n      skip_reason: skipReason,\n    },\n  });\n}\n\nreturn results;"
      },
      "id": "build-send-list",
      "name": "Build Send List",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [420, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-has-all-fields",
              "leftValue": "={{ $json.skip_reason }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "Ready To Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "skip-1", "name": "status", "value": "SKIPPED", "type": "string" },
            { "id": "skip-2", "name": "evaluation_id", "value": "={{ $json.evaluation_id }}", "type": "string" },
            { "id": "skip-3", "name": "reason", "value": "={{ $json.skip_reason }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "log-skipped",
      "name": "Skipped (missing data -- review these)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [860, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('CONFIG').item.json.whatsappGraphVersion }}/{{ $('CONFIG').item.json.whatsappPhoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $json.seller_phone_dial,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"evaluation_reminder\",\n    \"language\": { \"code\": \"en_US\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": $json.seller_name },\n          { \"type\": \"text\", \"text\": $json.agent_name },\n          { \"type\": \"text\", \"text\": $json.evaluation_time },\n          { \"type\": \"text\", \"text\": $json.property_address },\n          { \"type\": \"text\", \"text\": $json.agent_phone_display }\n        ]\n      }\n    ]\n  }\n} }}",
        "options": {}
      },
      "id": "send-template",
      "name": "Send WhatsApp Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 160],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "2", "name": "Meta WhatsApp Access Token" }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://{{ $('CONFIG').item.json.supabaseUrl.replace('https://', '') }}/rest/v1/evaluations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $('Build Send List').item.json.evaluation_id }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"reminder_sent\": true } }}",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Mark reminder_sent = true",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 80],
      "credentials": {
        "supabaseApi": { "id": "1", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "fail-1", "name": "status", "value": "SEND_FAILED -- reminder_sent NOT updated, will retry next poll", "type": "string" },
            { "id": "fail-2", "name": "evaluation_id", "value": "={{ $('Build Send List').item.json.evaluation_id }}", "type": "string" },
            { "id": "fail-3", "name": "seller_phone", "value": "={{ $('Build Send List').item.json.seller_phone_e164 }}", "type": "string" },
            { "id": "fail-4", "name": "error", "value": "={{ $json.error?.message || $json.message || JSON.stringify($json) }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "log-failure",
      "name": "Failed Sends (review these)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 260]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "CONFIG", "type": "main", "index": 0 }]]
    },
    "Manual Trigger (Testing)": {
      "main": [[{ "node": "CONFIG", "type": "main", "index": 0 }]]
    },
    "CONFIG": {
      "main": [[{ "node": "Compute Reminder Window", "type": "main", "index": 0 }]]
    },
    "Compute Reminder Window": {
      "main": [[{ "node": "Fetch Due Evaluations", "type": "main", "index": 0 }]]
    },
    "Fetch Due Evaluations": {
      "main": [[{ "node": "Build Send List", "type": "main", "index": 0 }]]
    },
    "Build Send List": {
      "main": [[{ "node": "Ready To Send?", "type": "main", "index": 0 }]]
    },
    "Ready To Send?": {
      "main": [
        [{ "node": "Send WhatsApp Template", "type": "main", "index": 0 }],
        [{ "node": "Skipped (missing data -- review these)", "type": "main", "index": 0 }]
      ]
    },
    "Send WhatsApp Template": {
      "main": [
        [{ "node": "Mark reminder_sent = true", "type": "main", "index": 0 }],
        [{ "node": "Failed Sends (review these)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
