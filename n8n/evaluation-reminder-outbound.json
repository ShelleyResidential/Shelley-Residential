{
  "name": "Evaluation Reminder - Outbound (WhatsApp)",
  "nodes": [
    {
      "parameters": {
        "content": "## Before this will work\n1. Create a **Supabase** credential (Host = your project URL, Service Role Secret = your service_role key) and attach it to both Supabase HTTP Request nodes.\n2. Create an **HTTP Header Auth** credential named e.g. \"Meta WhatsApp Access Token\" -- Name: `Authorization`, Value: `Bearer YOUR_LONG_LIVED_TOKEN`. Attach it to the \"Send WhatsApp Template\" node.\n3. Open the CONFIG node below and replace the two placeholder values with your real Supabase URL and WhatsApp Phone Number ID.\n4. Run once manually (the Manual Trigger) before turning on the schedule, to confirm it all works end to end.\n\n## Why \"Compute Reminder Window\" looks the way it does\nThe Shelley Residential app stores `scheduled_at` as the literal Johannesburg wall-clock digits with a UTC label attached (e.g. \"16:00 SAST\" is stored as `...T16:00:00+00:00`, NOT converted to real UTC) -- deliberate, so the app never has to do timezone math anywhere. `windowStart`/`windowEnd` are built to match that same convention (SAST digits, relabeled as UTC via a trailing \"Z\") rather than a truthful offset -- otherwise every comparison against `scheduled_at` would be off by exactly the SAST/UTC gap (2 hours). Don't \"fix\" this to use a real offset; it would break the comparison against real data.",
        "height": 460,
        "width": 420
      },
      "id": "sticky-setup",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-480, -80]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            { "field": "minutes", "minutesInterval": 15 }
          ]
        }
      },
      "id": "trigger-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [-480, 160]
    },
    {
      "parameters": {},
      "id": "trigger-manual",
      "name": "Manual Trigger (Testing)",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-480, 340]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "cfg-supabase-url",
              "name": "supabaseUrl",
              "value": "https://YOUR-PROJECT.supabase.co",
              "type": "string"
            },
            {
              "id": "cfg-phone-id",
              "name": "whatsappPhoneNumberId",
              "value": "YOUR_WHATSAPP_PHONE_NUMBER_ID",
              "type": "string"
            },
            {
              "id": "cfg-graph-version",
              "name": "whatsappGraphVersion",
              "value": "v21.0",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "config-node",
      "name": "CONFIG",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-240, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "win-1",
              "name": "windowStart",
              "value": "={{ $now.setZone('Africa/Johannesburg').plus({ minutes: 110 }).toFormat(\"yyyy-MM-dd'T'HH:mm:ss\") + 'Z' }}",
              "type": "string"
            },
            {
              "id": "win-2",
              "name": "windowEnd",
              "value": "={{ $now.setZone('Africa/Johannesburg').plus({ minutes: 125 }).toFormat(\"yyyy-MM-dd'T'HH:mm:ss\") + 'Z' }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "compute-window",
      "name": "Compute Reminder Window",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [-20, 240]
    },
    {
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "url": "={{ $json.supabaseUrl }}/rest/v1/evaluations",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "select",
              "value": "id,scheduled_at,property_id,sellers_agent_user_id,properties(street_number,street_name,suburb,city),agent:profiles!sellers_agent_user_id(full_name,phone_number),evaluation_contacts(is_primary,tag_option_id,contacts(first_name,last_name,phone_number),picklist_options:tag_option_id(label))"
            },
            { "name": "reminder_sent", "value": "eq.false" },
            { "name": "and", "value": "=(scheduled_at.gte.{{ $json.windowStart }},scheduled_at.lte.{{ $json.windowEnd }})" },
            { "name": "order", "value": "scheduled_at.asc" }
          ]
        },
        "options": {}
      },
      "id": "fetch-due",
      "name": "Fetch Due Evaluations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 240],
      "credentials": {
        "supabaseApi": { "id": "1", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "seller-1",
              "name": "seller_first_name",
              "value": "={{ ($json.evaluation_contacts.find(c => c.picklist_options?.label === 'Seller') || $json.evaluation_contacts.find(c => c.is_primary) || $json.evaluation_contacts[0])?.contacts?.first_name || null }}",
              "type": "string"
            },
            {
              "id": "seller-2",
              "name": "seller_last_name",
              "value": "={{ ($json.evaluation_contacts.find(c => c.picklist_options?.label === 'Seller') || $json.evaluation_contacts.find(c => c.is_primary) || $json.evaluation_contacts[0])?.contacts?.last_name || null }}",
              "type": "string"
            },
            {
              "id": "seller-3",
              "name": "seller_phone",
              "value": "={{ ($json.evaluation_contacts.find(c => c.picklist_options?.label === 'Seller') || $json.evaluation_contacts.find(c => c.is_primary) || $json.evaluation_contacts[0])?.contacts?.phone_number || null }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "extract-seller",
      "name": "Extract Seller",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [340, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "bsl-1", "name": "evaluation_id", "value": "={{ $json.id }}", "type": "string" },
            { "id": "bsl-2", "name": "seller_name", "value": "={{ [$json.seller_first_name, $json.seller_last_name].filter(v => v).join(' ') || null }}", "type": "string" },
            { "id": "bsl-3", "name": "agent_name", "value": "={{ $json.agent?.full_name || null }}", "type": "string" },
            {
              "id": "bsl-4",
              "name": "evaluation_time",
              "value": "={{ (() => { const d = $json.scheduled_at; const months = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec']; const mo = months[parseInt(d.slice(5,7),10)-1]; const day = parseInt(d.slice(8,10),10); return day + ' ' + mo + ' at ' + d.slice(11,16); })() }}",
              "type": "string"
            },
            { "id": "bsl-5", "name": "property_address", "value": "={{ [$json.properties?.street_number, $json.properties?.street_name, $json.properties?.suburb, $json.properties?.city].filter(v => v).join(', ') || 'the property' }}", "type": "string" },
            { "id": "bsl-6", "name": "agent_phone_display", "value": "={{ $json.agent?.phone_number || null }}", "type": "string" },
            { "id": "bsl-7", "name": "seller_phone_e164", "value": "={{ $json.seller_phone || null }}", "type": "string" },
            { "id": "bsl-8", "name": "seller_phone_dial", "value": "={{ $json.seller_phone ? $json.seller_phone.replace('+', '') : null }}", "type": "string" },
            {
              "id": "bsl-9",
              "name": "skip_reason",
              "value": "={{ !$json.seller_phone ? 'No seller phone number on file' : (!$json.agent?.phone_number) ? 'Assigned agent has no phone number on file' : (!$json.agent?.full_name) ? 'Evaluation has no assigned agent' : (!$json.seller_first_name && !$json.seller_last_name) ? 'Seller contact has no name on file' : null }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "build-send-list",
      "name": "Build Send List",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [560, 240]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "loose" },
          "conditions": [
            {
              "id": "cond-has-all-fields",
              "leftValue": "={{ $json.skip_reason }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "empty" }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-valid",
      "name": "Ready To Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [640, 240]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "skip-1", "name": "status", "value": "SKIPPED", "type": "string" },
            { "id": "skip-2", "name": "evaluation_id", "value": "={{ $json.evaluation_id }}", "type": "string" },
            { "id": "skip-3", "name": "reason", "value": "={{ $json.skip_reason }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "log-skipped",
      "name": "Skipped (missing data -- review these)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [860, 400]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/{{ $('CONFIG').item.json.whatsappGraphVersion }}/{{ $('CONFIG').item.json.whatsappPhoneNumberId }}/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ {\n  \"messaging_product\": \"whatsapp\",\n  \"to\": $json.seller_phone_dial,\n  \"type\": \"template\",\n  \"template\": {\n    \"name\": \"evaluation_reminder\",\n    \"language\": { \"code\": \"en_US\" },\n    \"components\": [\n      {\n        \"type\": \"body\",\n        \"parameters\": [\n          { \"type\": \"text\", \"text\": $json.seller_name },\n          { \"type\": \"text\", \"text\": $json.agent_name },\n          { \"type\": \"text\", \"text\": $json.evaluation_time },\n          { \"type\": \"text\", \"text\": $json.property_address },\n          { \"type\": \"text\", \"text\": $json.agent_phone_display }\n        ]\n      }\n    ]\n  }\n} }}",
        "options": {}
      },
      "id": "send-template",
      "name": "Send WhatsApp Template",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 160],
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": { "id": "2", "name": "Meta WhatsApp Access Token" }
      }
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "=https://{{ $('CONFIG').item.json.supabaseUrl.replace('https://', '') }}/rest/v1/evaluations",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "id", "value": "=eq.{{ $('Build Send List').item.json.evaluation_id }}" }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Prefer", "value": "return=minimal" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"reminder_sent\": true } }}",
        "options": {}
      },
      "id": "mark-sent",
      "name": "Mark reminder_sent = true",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1080, 80],
      "credentials": {
        "supabaseApi": { "id": "1", "name": "Supabase account" }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            { "id": "fail-1", "name": "status", "value": "SEND_FAILED -- reminder_sent NOT updated, will retry next poll", "type": "string" },
            { "id": "fail-2", "name": "evaluation_id", "value": "={{ $('Build Send List').item.json.evaluation_id }}", "type": "string" },
            { "id": "fail-3", "name": "seller_phone", "value": "={{ $('Build Send List').item.json.seller_phone_e164 }}", "type": "string" },
            { "id": "fail-4", "name": "error", "value": "={{ $json.error?.message || $json.message || JSON.stringify($json) }}", "type": "string" }
          ]
        },
        "options": {}
      },
      "id": "log-failure",
      "name": "Failed Sends (review these)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [1080, 260]
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "CONFIG", "type": "main", "index": 0 }]]
    },
    "Manual Trigger (Testing)": {
      "main": [[{ "node": "CONFIG", "type": "main", "index": 0 }]]
    },
    "CONFIG": {
      "main": [[{ "node": "Compute Reminder Window", "type": "main", "index": 0 }]]
    },
    "Compute Reminder Window": {
      "main": [[{ "node": "Fetch Due Evaluations", "type": "main", "index": 0 }]]
    },
    "Fetch Due Evaluations": {
      "main": [[{ "node": "Extract Seller", "type": "main", "index": 0 }]]
    },
    "Extract Seller": {
      "main": [[{ "node": "Build Send List", "type": "main", "index": 0 }]]
    },
    "Build Send List": {
      "main": [[{ "node": "Ready To Send?", "type": "main", "index": 0 }]]
    },
    "Ready To Send?": {
      "main": [
        [{ "node": "Send WhatsApp Template", "type": "main", "index": 0 }],
        [{ "node": "Skipped (missing data -- review these)", "type": "main", "index": 0 }]
      ]
    },
    "Send WhatsApp Template": {
      "main": [
        [{ "node": "Mark reminder_sent = true", "type": "main", "index": 0 }],
        [{ "node": "Failed Sends (review these)", "type": "main", "index": 0 }]
      ]
    }
  },
  "active": false,
  "settings": { "executionOrder": "v1" },
  "pinData": {}
}
